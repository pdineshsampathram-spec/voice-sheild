# VoiceShield Environment Configuration

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Model paths (auto-downloaded from HuggingFace if not present)
SPECTRA_MODEL_ID=lab260/Spectra-AASIST
ECAPA_MODEL_ID=speechbrain/spkrec-ecapa-voxceleb
MODEL_CACHE_DIR=./model_cache

# Device: auto, cpu, cuda
DEVICE=auto

# Audio settings
SAMPLE_RATE=16000
SPECTRA_WINDOW_SAMPLES=64600
SLIDING_WINDOW_OVERLAP=0.5

# Risk engine thresholds — CONFIGURABLE, requires calibration
# These are starting defaults, NOT validated thresholds
SPOOF_THRESHOLD_CRITICAL=0.85
SPOOF_THRESHOLD_HIGH=0.70
SPOOF_THRESHOLD_MEDIUM=0.40
SPEAKER_THRESHOLD_MATCH=0.25
RISK_WINDOW_COUNT=5
RISK_ESCALATION_COUNT=3

# Database
DATABASE_URL=postgresql://voiceshield:voiceshield@localhost:5432/voiceshield

# Redis
REDIS_URL=redis://localhost:6379/0

# Speaker profiles storage
SPEAKER_PROFILES_DIR=./speaker_profiles

# ==============================================================================
# Twilio + ElevenLabs Outbound Caller Agent (Trial / Unverified Account)
# ==============================================================================
# Twilio Account Credentials (from https://console.twilio.com/)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# CRITICAL TRIAL RESTRICTION: Only this verified destination number will be called
TWILIO_VERIFIED_DESTINATION_NUMBER=+91XXXXXXXXXX

# ElevenLabs Conversational AI Credentials (from https://elevenlabs.io/)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# Public HTTPS URL of this backend (e.g. from ngrok: https://xxxx.ngrok-free.app)
# Required so Twilio can reach /caller/twiml and /caller/status-callback
BACKEND_PUBLIC_URL=https://your-tunnel-url.ngrok-free.app

# Set to false only during automated tests or local debugging if signature check fails behind proxy
TWILIO_WEBHOOK_VALIDATE_SIGNATURE=true
