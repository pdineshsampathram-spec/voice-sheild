<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Telephony permissions -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Audio permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Notifications & foreground service -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!-- Internet (for WebSocket to backend in development mode) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Storage permissions for automatic OEM call recording discovery (MIUI/POCO prototype) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:name=".VoiceShieldApp"
        android:allowBackup="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="VoiceShield"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true">

            <!-- Standard launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Dialer intent filters (required for default dialer role) -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <data android:scheme="tel" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- VoiceShield InCallService -->
        <service
            android:name=".telecom.VoiceShieldInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true"
            android:foregroundServiceType="phoneCall">

            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!-- IN_CALL_SERVICE_RINGING intentionally NOT declared.
                 Android Telecom will play the system ringtone for incoming calls.
                 VoiceShield does not implement custom ringtone playback. -->

            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- VoiceShield Call Screening Service -->
        <service
            android:name=".telecom.VoiceShieldCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">

            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Explicitly remove dialer-core conflicting services and activities to prevent dual InCallService collisions -->
        <service
            android:name="com.fayyaztech.dialer_core.services.DefaultInCallService"
            tools:node="remove" />
        <service
            android:name="com.fayyaztech.dialer_core.services.CallScreeningService"
            tools:node="remove" />
        <service
            android:name="com.fayyaztech.dialer_core.services.CallStateObserverService"
            tools:node="remove" />
        <activity
            android:name="com.fayyaztech.dialer_core.ui.call.CallScreenActivity"
            tools:node="remove" />
        <receiver
            android:name="com.fayyaztech.dialer_core.services.IncomingCallReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.fayyaztech.dialer_core.services.CallActionReceiver"
            tools:node="remove" />

    </application>
</manifest>
